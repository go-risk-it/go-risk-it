        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Normal: 0 empty acquires/sec with utilization < 60%. Watch for: rising empty acquire rate \u2014 leading indicator that pool will saturate before canceled acquires appear. Check next: canceled acquires stat for confirmation of full exhaustion.",
            "fieldConfig": {
