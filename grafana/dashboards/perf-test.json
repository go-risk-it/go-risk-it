            "id": 100,
            "title": "Observe \u2014 Am I OK?",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Number of games currently in progress. Normal: matches configured concurrency. Watch for: stuck at 0 (no games starting) or exceeding target (games not completing). Check next: Game Completion panel for timeout/fatal counts.",
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 200
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 6,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "perftest_games_active{service_name=\"perftest\"}",
                    "legendFormat": "active",
                    "refId": "A"
                }
            ],
            "title": "Active Games",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "Client-side move throughput (30s rate). Normal: proportional to active games. Watch for: sudden drops (server overload) or flat line at zero (test harness stuck). Check next: E2E Move Latency to see if slowdown explains throughput drop.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "fixedColor": "#73BF69",
                        "mode": "fixed"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 15,
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        }
                    },
                    "links": [
                        {
                            "targetBlank": true,
                            "title": "Game Engine",
                            "url": "/d/game-engine?from=${__from}&to=${__to}"
                        }
                    ],
                    "unit": "ops"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 6,
                "w": 9,
                "x": 6,
                "y": 1
