{
    "annotations": {
        "list": []
    },
    "description": "Full request lifecycle: HTTP ingress through game logic, DB transaction, WS broadcast, and async event handling",
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "title": "Observe \u2014 Am I OK?",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "description": "P95 latency for each boundary in the request lifecycle overlaid. HTTP Total is the synchronous request; Event Handler is async post-response work (dashed). Normal: DB + Game Logic + WS sum to roughly HTTP Total; Event Handler runs independently after response. Watch for: Event Handler exceeding HTTP Total (async work slower than the request itself). Check next: Event Handler Latency panel for per-consumer breakdown.",
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        }
                    },
                    "links": [
                        {
                            "targetBlank": true,
                            "title": "Database",
                            "url": "/d/database?from=${__from}&to=${__to}"
                        },
                        {
                            "targetBlank": true,
                            "title": "WebSocket",
                            "url": "/d/websocket?from=${__from}&to=${__to}"
                        },
                        {
                            "targetBlank": true,
                            "title": "Game Engine",
                            "url": "/d/game-engine?from=${__from}&to=${__to}"
                        },
                        {
                            "targetBlank": true,
                            "title": "Command Center",
                            "url": "/d/perf-test-command-center?from=${__from}&to=${__to}"
                        }
                    ],
                    "unit": "s"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "HTTP Total"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#FF9830",
                                    "mode": "fixed"
                                }
                            },
                            {
                                "id": "custom.lineWidth",
                                "value": 3
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "DB Transaction"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#3274D9",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Game Logic"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#56A64B",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "WS Broadcast"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#8F3BB8",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Event Handler (post-response)"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#00BCD4",
                                    "mode": "fixed"
                                }
                            },
                            {
                                "id": "custom.lineStyle",
                                "value": {
                                    "dash": [
                                        10,
                                        10
                                    ],
                                    "fill": "dash"
                                }
                            },
                            {
                                "id": "custom.fillOpacity",
                                "value": 0
                            }
                        ]
                    }
                ]
            },
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "options": {
                "legend": {
                    "calcs": [
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "exemplar": true,
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"risk-it\"}[1m])) by (le))",
                    "legendFormat": "HTTP Total",
                    "refId": "A"
                },
                {
                    "exemplar": true,
                    "expr": "histogram_quantile(0.95, sum(rate(db_transaction_duration_seconds_bucket{service_name=\"risk-it\"}[1m])) by (le))",
                    "legendFormat": "DB Transaction",
                    "refId": "B"
                },
                {
                    "exemplar": true,
                    "expr": "histogram_quantile(0.95, sum(rate(game_phase_duration_seconds_bucket{service_name=\"risk-it\"}[1m])) by (le))",
                    "legendFormat": "Game Logic",
                    "refId": "C"
