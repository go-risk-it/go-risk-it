{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "packageRules": [
    {
      "description": "Disable digest and pin updates — no supply-chain value for a personal project",
      "matchUpdateTypes": [
        "digest",
        "pin"
      ],
      "enabled": false
    },
    {
      "description": "Patch updates automerge silently via branch (no PR unless CI fails)",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Minor updates get individual PRs, automerge if CI passes",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch"
  }
}
